# Anthropic key, used only by the server routes in src/app/api.
ANTHROPIC_API_KEY=

# Optional model overrides.
# CONSTELLATION_PRIMARY_MODEL=claude-opus-5-5
# CONSTELLATION_CHEAP_MODEL=claude-haiku-5-5

# Supabase project (Project Settings → API). Leave blank for local mode:
# no sign-in, and your space is stored in this browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production refuses to serve the AI routes without sign-in unless this is set.
# ALLOW_LOCAL_MODE=true

# Optional: reads posts on X through X's official API (developer.x.com → your app →
# Keys and tokens → Bearer Token). Without it, X links are read best-effort and often fail.
# X_BEARER_TOKEN=

# Optional: price and valuation charts for tickers, from Financial Modeling Prep
# (financialmodelingprep.com → Dashboard → API key). The free plan covers US stocks.
# FMP_API_KEY=

# Optional: SEC EDGAR asks every visitor to say who they are. Set this to your name and email,
# e.g. "Jane Smith jane@fund.com", so links to sec.gov filings are read in full.
# SEC_USER_AGENT=
