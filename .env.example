# Anthropic key, used only by the server routes in src/app/api.
ANTHROPIC_API_KEY=

# Optional model overrides.
# CONSTELLATION_PRIMARY_MODEL=claude-opus-5-5   (Ask and Find ideas)
# CONSTELLATION_WORK_MODEL=claude-sonnet-5-5   (reading saves, connecting, read-throughs, reorganizing)
# CONSTELLATION_CHEAP_MODEL=claude-haiku-5-5

# Supabase project (Project Settings → API). Leave blank for local mode:
# no sign-in, and your space is stored in this browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production refuses to serve the AI routes without sign-in unless this is set.
# ALLOW_LOCAL_MODE=true

# Optional: reads posts on X through X's official API (developer.x.com → your app →
# Keys and tokens → Bearer Token). Without it, X links are read best-effort and often fail.
# X_BEARER_TOKEN=

# Optional: price and valuation charts for tickers, from Financial Modeling Prep
# (financialmodelingprep.com → Dashboard → API key). The free plan covers US stocks.
# FMP_API_KEY=

# Optional: SEC EDGAR asks every visitor to say who they are. Set this to your name and email,
# e.g. "Jane Smith jane@fund.com", so links to sec.gov filings are read in full.
# SEC_USER_AGENT=

# News watch on saved pitches. An AI agent checks the news on each saved pitch (not pitch ideas)
# and comments on what it means for the pitch. It searches the web through the Anthropic key, so
# no news API key is needed. Run supabase/migrations/0004_pitch_news.sql first.
# The background job (and emails) need the service role key (Supabase → Project Settings → API)
# and a secret the scheduler sends; see .github/workflows/news-watch.yml.
# SUPABASE_SERVICE_ROLE_KEY=
# CRON_SECRET=           any long random string, e.g. from `openssl rand -hex 32`
# NEWS_SCAN_HOURS=4      how often each pitch is checked
# NEWS_SCAN_BATCH=8      pitches checked per scheduler call

# Optional: email the news watch's findings (per pitch, switched on from the pitch's dashboard)
# through Resend (resend.com → API Keys). Until you verify a domain, Resend only sends from
# onboarding@resend.dev to the email you signed up with.
# RESEND_API_KEY=
# NEWS_EMAIL_FROM=Constellation <onboarding@resend.dev>
# APP_URL=https://your-app.vercel.app   (linked in the emails)
